# OPTIONAL overrides for compose.yaml. You do NOT need to copy this file to start the demo:
# "docker compose up --build" works with the built-in defaults shown below.
#
# To override, copy this file to .env in the project root and change values. Docker Compose reads it for
# variable substitution. All defaults are non-sensitive demo values; never put real secrets in this repository.

# Host port bound to 127.0.0.1 only.
APP_PORT=8080

# Leave empty to let the container generate a demo key once and keep it in the app-data volume.
APP_KEY=

APP_DEBUG=false

# Demo database credentials. Changing them after the first start requires a reset of the mysql-data volume.
DB_DATABASE=commission
DB_USERNAME=commission
DB_PASSWORD=commission_demo_password
DB_ROOT_PASSWORD=root_demo_password
