<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory="storage/framework/phpunit"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- Fixed, non-secret key used only by the test suite. -->
        <env name="APP_KEY" value="base64:bDQw/Yv+4dQ/R7qXewv4zYlJI7DVzULitaxsWEqVfKM=" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!-- Separate MySQL test database and credentials, provisioned by docker/mysql/initdb. -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="commission_test" force="true"/>
        <env name="DB_USERNAME" value="commission_test" force="true"/>
        <env name="DB_PASSWORD" value="commission_test_password" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <!-- Laravel reads $_SERVER before $_ENV, and Compose environment variables appear in both. -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_KEY" value="base64:bDQw/Yv+4dQ/R7qXewv4zYlJI7DVzULitaxsWEqVfKM="/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_DATABASE" value="commission_test"/>
        <server name="DB_USERNAME" value="commission_test"/>
        <server name="DB_PASSWORD" value="commission_test_password"/>
        <server name="DB_URL" value=""/>
        <server name="LOG_CHANNEL" value="null"/>
        <server name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
